# Database
DATABASE_URL="postgresql://hubso:hubso_dev_password@localhost:5434/hubso?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Meta / Instagram OAuth
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"
META_REDIRECT_URI="http://localhost:3000/api/v1/auth/meta/callback"

# Encryption (AES-256-GCM)
ENCRYPTION_KEY="your-32-byte-encryption-key-here!!"

# Redis
REDIS_URL="redis://localhost:6379"

# Email (Resend)
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="noreply@hubso.io"
EMAIL_FROM_NAME="Hubso"

# Stripe (da configurare in settimana 5)
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_ID="price_..."

# App
APP_NAME="Hubso"
APP_URL="http://localhost:4200"
API_URL="http://localhost:3000"
PORT="3000"
NODE_ENV="development"