---
File di Configurazione
docker-compose.yml
services:
  postgres:
    image: postgres:16-alpine   # Versione esatta
    environment:
      POSTGRES_USER: hubso
      POSTGRES_PASSWORD: hubso_dev_password
      POSTGRES_DB: hubso
    ports:
      - "5432:5432"             # Accessibile da localhost:5432
    volumes:
      - postgres_data:/var/lib/postgresql/data  # Dati persistenti
  redis:
    image: redis:7-alpine
    ports:
      - "6379:6379"             # Accessibile da localhost:6379
    volumes:
      - redis_data:/data        # Dati persistenti
volumes:
  postgres_data:    # Volume Docker che sopravvive ai riavvii
  redis_data:
Connessione dal Backend
// hubso-api/.env
DATABASE_URL="postgresql://hubso:hubso_dev_password@localhost:5432/hubso?schema=public"
// hubso-api/prisma/prisma.service.ts
// Prisma usa DATABASE_URL per connettersi al container PostgreSQL
---
Troubleshooting Comune
Problema: "Porta già in uso"
# Se hai già PostgreSQL installato sul sistema
# Cambia porta nel docker-compose.yml:
ports:
  - "5433:5432"  # Usa 5433 invece di 5432
# E aggiorna DATABASE_URL di conseguenza
Problema: "Container non parte"
# Controlla i log
docker compose logs postgres
# Reset completo (perde tutti i dati!)
docker compose down -v
docker compose up -d
Problema: "Prisma non trova il database"
# Assicurati che Docker sia attivo
docker ps
# Verifica che Prisma possa connettersi
cd hubso-api
npx prisma db pull
